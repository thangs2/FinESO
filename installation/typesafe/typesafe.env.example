# Copy to typesafe.env (this repo tracks typesafe.env for private GitLab — rotate if repo is shared).
# Console: https://console.typesafe.ai/keys

TYPESAFE_API_KEY=apikey_your_key_here
TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Optional override; canonical source is <repo>/.harness/decision-policy.json → jev.mode
# loadDecisionPolicy() also honors JEV_MODE=off|shadow|active when set in the shell.
JEV_MODE=active
